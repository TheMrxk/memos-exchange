# MemOS Exchange - Web Backend
FROM python:3.11-slim

WORKDIR /app

# 安装依赖
COPY src/web-backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制后端代码
COPY src/web-backend/ ./
COPY src/local-memory-plugin/db/ ./db/

# 创建数据目录
RUN mkdir -p /app/data

# 暴露端口
EXPOSE 5001

# 启动命令
CMD ["python", "app.py"]
