<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Memory Exchange - 记忆管理</title>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/element-plus/dist/index.css">
    <script src="https://unpkg.com/element-plus"></script>
    <script src="https://unpkg.com/@element-plus/icons-vue"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f5f7fa; }
        .app { min-height: 100vh; }
        .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px 40px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); }
        .header h1 { font-size: 24px; font-weight: 600; }
        .header p { opacity: 0.8; margin-top: 5px; }
        .nav { display: flex; gap: 10px; margin-top: 15px; }
        .nav button { background: rgba(255,255,255,0.2); border: none; color: white; padding: 8px 16px; border-radius: 6px; cursor: pointer; transition: all 0.3s; }
        .nav button:hover, .nav button.active { background: rgba(255,255,255,0.35); }
        .container { max-width: 1400px; margin: 0 auto; padding: 24px; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px; }
        .stat-card { background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
        .stat-card .value { font-size: 32px; font-weight: 700; color: #667eea; }
        .stat-card .label { color: #909399; margin-top: 8px; font-size: 14px; }
        .card { background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); margin-bottom: 20px; }
        .card h2 { font-size: 18px; margin-bottom: 16px; color: #303133; }
        .search-bar { display: flex; gap: 10px; margin-bottom: 20px; }
        .search-bar input { flex: 1; padding: 12px 16px; border: 1px solid #dcdfe6; border-radius: 8px; font-size: 14px; }
        .search-bar button { padding: 12px 24px; background: #667eea; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; }
        .search-bar button:hover { background: #5568d3; }
        .memory-item { border: 1px solid #e4e7ed; border-radius: 8px; padding: 16px; margin-bottom: 12px; transition: all 0.3s; }
        .memory-item:hover { box-shadow: 0 4px 16px rgba(102,126,234,0.15); border-color: #667eea; }
        .memory-item .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .memory-item .type { padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 500; }
        .type-preference { background: #fef0f0; color: #f56c6c; }
        .type-skill { background: #f0f9ff; color: #409eff; }
        .type-experience { background: #f7fee7; color: #84cc16; }
        .type-fact { background: #f3f4f6; color: #6b7280; }
        .memory-item .content { color: #606266; line-height: 1.6; }
        .memory-item .meta { display: flex; gap: 15px; margin-top: 12px; font-size: 13px; color: #909399; }
        .tags { display: flex; gap: 6px; flex-wrap: wrap; }
        .tag { background: #f3f4f6; color: #6b7280; padding: 3px 8px; border-radius: 4px; font-size: 12px; }
        .actions { display: flex; gap: 8px; }
        .empty { text-align: center; padding: 60px 20px; color: #909399; }
        .loading { text-align: center; padding: 40px; color: #667eea; }
        .pagination { display: flex; justify-content: center; gap: 8px; margin-top: 20px; }
        .pagination button { padding: 8px 14px; border: 1px solid #dcdfe6; background: white; border-radius: 6px; cursor: pointer; }
        .pagination button.active { background: #667eea; color: white; border-color: #667eea; }
        .dialog-footer { display: flex; justify-content: flex-end; gap: 10px; }
        .type-select { display: flex; gap: 10px; margin-bottom: 16px; }
        .type-select button { flex: 1; padding: 10px; border: 2px solid #e4e7ed; background: white; border-radius: 8px; cursor: pointer; transition: all 0.3s; }
        .type-select button.active { border-color: #667eea; background: #667eea; color: white; }
        .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 4px 12px; border-radius: 12px; font-size: 13px; font-weight: 500; }
        .status-online { background: #d1fae5; color: #065f46; }
        .status-offline { background: #fee2e2; color: #991b1b; }
        .highlight { background: #fef3c7; color: #92400e; padding: 2px 6px; border-radius: 4px; font-weight: 600; }
        .search-input-focus { border-color: #10b981 !important; box-shadow: 0 0 0 3px rgba(16,185,129,0.1); }
    </style>
</head>
<body>
    <div id="app">
        <div class="app">
            <header class="header">
                <h1>🧠 Memory Exchange</h1>
                <p>本地记忆管理系统</p>
                <nav class="nav">
                    <button :class="{ active: currentPage === 'dashboard' }" @click="currentPage = 'dashboard'">📊 仪表盘</button>
                    <button :class="{ active: currentPage === 'memories' }" @click="currentPage = 'memories'">📝 记忆管理</button>
                    <button :class="{ active: currentPage === 'conversations' }" @click="currentPage = 'conversations'">💬 对话记录</button>
                    <button :class="{ active: currentPage === 'settings' }" @click="currentPage = 'settings'">⚙️ 设置</button>
                </nav>
            </header>

            <main class="container">
                <!-- 仪表盘 -->
                <div v-if="currentPage === 'dashboard'">
                    <!-- 全局搜索 -->
                    <div class="card" style="border-left: 4px solid #10b981;">
                        <h2 style="display: flex; align-items: center; gap: 10px;">
                            🔍 全局搜索
                        </h2>
                        <div style="margin-top: 16px;">
                            <div style="display: flex; gap: 10px; margin-bottom: 12px;">
                                <input v-model="globalSearchQuery" @keyup.enter="globalSearch"
                                       placeholder="输入关键词搜索记忆和对话记录..."
                                       :class="searchFocused ? 'search-input-focus' : ''"
                                       style="flex: 1; padding: 14px 18px; border: 2px solid #e4e7ed; border-radius: 10px; font-size: 15px; outline: none; transition: border-color 0.3s;"
                                       @focus="searchFocused = true" @blur="searchFocused = false">
                                <button @click="globalSearch"
                                        style="padding: 14px 28px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 10px; cursor: pointer; font-size: 15px; font-weight: 500; min-width: 120px;">
                                    {{ searchLoading ? '搜索中...' : '🔍 搜索' }}
                                </button>
                            </div>
                            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 14px; color: #64748b; cursor: pointer;">
                                    <input type="checkbox" v-model="searchMemoriesOnly" style="width: 16px; height: 16px;">
                                    仅搜索记忆
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 14px; color: #64748b; cursor: pointer;">
                                    <input type="checkbox" v-model="searchConversationsOnly" style="width: 16px; height: 16px;">
                                    仅搜索对话
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 14px; color: #64748b; cursor: pointer;">
                                    <input type="checkbox" v-model="searchExactMatch" style="width: 16px; height: 16px;">
                                    精确匹配
                                </label>
                            </div>
                        </div>
                        <!-- 搜索历史 -->
                        <div v-if="searchHistory.length > 0" style="margin-top: 12px;">
                            <span style="font-size: 13px; color: #94a3b8;">最近搜索：</span>
                            <span v-for="(hist, idx) in searchHistory" :key="idx"
                                  @click="globalSearchQuery = hist; globalSearch()"
                                  style="display: inline-block; padding: 4px 10px; background: #f1f5f9; border-radius: 16px; font-size: 13px; color: #475569; cursor: pointer; margin-right: 6px; margin-bottom: 6px;">
                                {{ hist }}
                            </span>
                        </div>
                    </div>

                    <!-- 搜索结果 -->
                    <div v-if="searchResults.show" class="card" style="border-left: 4px solid #667eea;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                            <h2>📊 搜索结果 "{{ searchResults.query }}"</h2>
                            <button @click="clearSearchResults" style="padding: 6px 14px; background: #f1f5f9; color: #64748b; border: none; border-radius: 6px; cursor: pointer; font-size: 13px;">清空结果</button>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <!-- 记忆结果 -->
                            <div v-if="!searchConversationsOnly">
                                <h3 style="font-size: 15px; color: #475569; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                                    📝 记忆
                                    <span style="padding: 2px 8px; background: #e0e7ff; color: #4338ca; border-radius: 12px; font-size: 12px;">{{ searchResults.memories.length }} 条</span>
                                </h3>
                                <div v-if="searchResults.memories.length === 0" style="padding: 20px; text-align: center; color: #94a3b8;">无相关记忆</div>
                                <div v-else v-for="mem in searchResults.memories" :key="mem.id"
                                     class="memory-item"
                                     style="padding: 12px; margin-bottom: 10px; cursor: pointer;"
                                     @click="currentPage = 'memories'; searchQuery = mem.content.substring(0, 30);">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                                        <span class="type" :class="'type-' + mem.memory_type">{{ getTypeLabel(mem.memory_type) }}</span>
                                        <span v-if="mem.score" style="color: #667eea; font-size: 12px;">相关度：{{ Math.round(mem.score * 100) }}%</span>
                                    </div>
                                    <div class="content" style="font-size: 14px;" v-html="highlightText(mem.content, searchResults.query)"></div>
                                    <div class="meta" style="margin-top: 8px;">
                                        <span style="font-size: 12px;">📅 {{ formatDate(mem.created_at) }}</span>
                                    </div>
                                </div>
                            </div>
                            <!-- 对话结果 -->
                            <div v-if="!searchMemoriesOnly">
                                <h3 style="font-size: 15px; color: #475569; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                                    💬 对话
                                    <span style="padding: 2px 8px; background: #fef3c7; color: #92400e; border-radius: 12px; font-size: 12px;">{{ searchResults.conversations.length }} 条</span>
                                </h3>
                                <div v-if="searchResults.conversations.length === 0" style="padding: 20px; text-align: center; color: #94a3b8;">无相关对话</div>
                                <div v-else v-for="conv in searchResults.conversations" :key="conv.id"
                                     class="memory-item"
                                     style="padding: 12px; margin-bottom: 10px; cursor: pointer;"
                                     @click="currentPage = 'conversations'">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                                        <span class="type" :style="{ background: conv.role === 'user' ? '#dbeafe' : '#fef3c7', color: conv.role === 'user' ? '#1e40af' : '#92400e' }">
                                            {{ conv.role === 'user' ? '👤 用户' : '🤖 助手' }}
                                        </span>
                                        <span style="font-size: 12px; color: #94a3b8;">{{ formatDate(conv.timestamp) }}</span>
                                    </div>
                                    <div class="content" style="font-size: 14px; white-space: pre-wrap;" v-html="highlightText(conv.content, searchResults.query)"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- LLM 连接状态 -->
                    <div class="card" style="border-left: 4px solid #8b5cf6;">
                        <h2 style="display: flex; align-items: center; gap: 10px;">
                            🤖 LLM 智能摘要
                            <span :class="['status-badge', llmConfigured ? 'status-online' : 'status-offline']">
                                {{ llmConfigured ? '● 已配置' : '● 未配置' }}
                            </span>
                        </h2>
                        <div style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px;">
                            <div style="padding: 12px; background: #f8fafc; border-radius: 8px;">
                                <div style="font-size: 12px; color: #64748b;">服务商</div>
                                <div style="font-size: 14px; font-weight: 500; color: #334155; margin-top: 4px;">{{ llmConfig.provider || '-' }}</div>
                            </div>
                            <div style="padding: 12px; background: #f8fafc; border-radius: 8px;">
                                <div style="font-size: 12px; color: #64748b;">模型</div>
                                <div style="font-size: 14px; font-weight: 500; color: #334155; margin-top: 4px;">{{ llmConfig.model || '-' }}</div>
                            </div>
                            <div style="padding: 12px; background: #f8fafc; border-radius: 8px;">
                                <div style="font-size: 12px; color: #64748b;">API Key</div>
                                <div style="font-size: 14px; font-weight: 500; color: #334155; margin-top: 4px;">{{ llmConfig.api_key || '未配置' }}</div>
                            </div>
                            <div style="padding: 12px; background: #f8fafc; border-radius: 8px; cursor: pointer;" @click="currentPage = 'settings'"
                                 style="display: flex; align-items: center; justify-content: center; color: #667eea; font-weight: 500;">
                                → 配置 LLM
                            </div>
                        </div>
                    </div>
                    <!-- OpenClaw 连接状态 -->
                    <div class="card" style="border-left: 4px solid #667eea;">
                        <h2 style="display: flex; align-items: center; gap: 10px;">
                            🔌 OpenClaw 连接状态
                            <span :class="['status-badge', apiConnected ? 'status-online' : 'status-offline']">
                                {{ apiConnected ? '● 已连接' : '● 离线' }}
                            </span>
                        </h2>
                        <div style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px;">
                            <div style="padding: 12px; background: #f8fafc; border-radius: 8px;">
                                <div style="font-size: 12px; color: #64748b;">API 地址</div>
                                <div style="font-size: 14px; font-weight: 500; color: #334155; margin-top: 4px;">{{ API_BASE }}</div>
                            </div>
                            <div style="padding: 12px; background: #f8fafc; border-radius: 8px;">
                                <div style="font-size: 12px; color: #64748b;">最后检查</div>
                                <div style="font-size: 14px; font-weight: 500; color: #334155; margin-top: 4px;">{{ lastCheckTime }}</div>
                            </div>
                            <div style="padding: 12px; background: #f8fafc; border-radius: 8px;">
                                <div style="font-size: 12px; color: #64748b;">响应时间</div>
                                <div style="font-size: 14px; font-weight: 500; color: #334155; margin-top: 4px;">{{ responseTime }}ms</div>
                            </div>
                        </div>
                    </div>

                    <!-- API 调用统计 -->
                    <div class="card" style="border-left: 4px solid #10b981;">
                        <h2 style="display: flex; align-items: center; gap: 10px;">
                            📊 API 调用统计 ({{ timeRange }})
                        </h2>
                        <div class="stats-grid" style="margin-top: 16px;">
                            <div class="stat-card">
                                <div class="value" style="font-size: 24px;">{{ apiStats.total_calls || 0 }}</div>
                                <div class="label">调用次数</div>
                            </div>
                            <div class="stat-card">
                                <div class="value" style="font-size: 24px;">{{ apiStats.avg_response_time_ms || 0 }}ms</div>
                                <div class="label">平均响应时间</div>
                            </div>
                            <div class="stat-card">
                                <div class="value" style="font-size: 24px; color: #ef4444;">{{ apiStats.error_count || 0 }}</div>
                                <div class="label">错误次数</div>
                            </div>
                            <div class="stat-card">
                                <div class="value" style="font-size: 24px; color: #10b981;">{{ (apiStats.calls_by_source || {}).web || 0 }}</div>
                                <div class="label">Web 访问</div>
                            </div>
                        </div>
                        <!-- 按端点统计 -->
                        <div v-if="Object.keys(apiStats.calls_by_endpoint || {}).length > 0" style="margin-top: 16px;">
                            <h3 style="font-size: 14px; color: #64748b; margin-bottom: 8px;">热门端点</h3>
                            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                <span v-for="(count, endpoint) in apiStats.calls_by_endpoint" :key="endpoint"
                                      style="padding: 6px 12px; background: #f1f5f9; border-radius: 6px; font-size: 13px;">
                                    {{ endpoint }}: {{ count }}
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- 数据库统计 -->
                    <div class="card" style="border-left: 4px solid #8b5cf6;">
                        <h2>📈 数据库统计</h2>
                        <div class="stats-grid" style="margin-top: 16px;">
                            <div class="stat-card">
                                <div class="value">{{ stats.total_conversations }}</div>
                                <div class="label">对话记录</div>
                            </div>
                            <div class="stat-card">
                                <div class="value">{{ stats.total_memories }}</div>
                                <div class="label">记忆总数</div>
                            </div>
                            <div class="stat-card">
                                <div class="value">{{ formatSize(stats.database_size_bytes) }}</div>
                                <div class="label">数据库大小</div>
                            </div>
                            <div class="stat-card">
                                <div class="value">{{ stats.active_sessions }}</div>
                                <div class="label">活跃会话</div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <h2>🔗 快速链接</h2>
                        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                            <button @click="currentPage = 'memories'" style="padding: 10px 20px; background: #667eea; color: white; border: none; border-radius: 8px; cursor: pointer;">浏览记忆</button>
                            <button @click="currentPage = 'conversations'" style="padding: 10px 20px; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer;">查看对话</button>
                            <button @click="showAddMemory = true" style="padding: 10px 20px; background: #f59e0b; color: white; border: none; border-radius: 8px; cursor: pointer;">添加记忆</button>
                        </div>
                    </div>
                </div>

                <!-- 记忆管理 -->
                <div v-if="currentPage === 'memories'">
                    <div class="card">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                            <h2>📝 记忆列表</h2>
                            <button @click="showAddMemory = true" style="padding: 10px 20px; background: #667eea; color: white; border: none; border-radius: 8px; cursor: pointer;">+ 添加记忆</button>
                        </div>

                        <div class="search-bar">
                            <input v-model="searchQuery" @keyup.enter="searchMemories" placeholder="搜索记忆...">
                            <button @click="searchMemories">🔍 搜索</button>
                        </div>

                        <div class="type-select" style="max-width: 400px;">
                            <button :class="{ active: filterType === '' }" @click="filterType = ''">全部</button>
                            <button :class="{ active: filterType === 'preference' }" @click="filterType = 'preference'">偏好</button>
                            <button :class="{ active: filterType === 'skill' }" @click="filterType = 'skill'">技能</button>
                            <button :class="{ active: filterType === 'experience' }" @click="filterType = 'experience'">经验</button>
                            <button :class="{ active: filterType === 'fact' }" @click="filterType = 'fact'">事实</button>
                        </div>

                        <div v-if="loading" class="loading">加载中...</div>
                        <div v-else-if="memories.length === 0" class="empty">暂无记忆</div>
                        <div v-else>
                            <div v-for="mem in memories" :key="mem.id" class="memory-item">
                                <div class="header" style="display: flex; justify-content: space-between; align-items: flex-start;">
                                    <div>
                                        <span class="type" :class="'type-' + mem.memory_type">{{ getTypeLabel(mem.memory_type) }}</span>
                                        <span v-if="mem.score" style="margin-left: 10px; color: #667eea;">相关度：{{ Math.round(mem.score * 100) }}%</span>
                                    </div>
                                    <div class="actions">
                                        <button @click="editMemory(mem)" style="padding: 5px 12px; background: #3b82f6; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px;">编辑</button>
                                        <button @click="deleteMemory(mem.id)" style="padding: 5px 12px; background: #ef4444; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px;">删除</button>
                                    </div>
                                </div>
                                <div class="content">{{ mem.content }}</div>
                                <div class="meta">
                                    <span>📅 {{ formatDate(mem.created_at) }}</span>
                                    <span v-if="mem.tags && mem.tags.length">🏷️
                                        <span class="tags">
                                            <span v-for="tag in mem.tags" :key="tag" class="tag">{{ tag }}</span>
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div v-if="memories.length > 0" class="pagination">
                            <button @click="prevPage" :disabled="page === 1">上一页</button>
                            <span style="padding: 8px;">第 {{ page }} 页</span>
                            <button @click="nextPage">下一页</button>
                        </div>
                    </div>
                </div>

                <!-- 对话记录 -->
                <div v-if="currentPage === 'conversations'">
                    <div class="card">
                        <h2>💬 对话记录</h2>
                        <div v-if="conversationsLoading" class="loading">加载中...</div>
                        <div v-else-if="conversations.length === 0" class="empty">暂无对话记录</div>
                        <div v-else>
                            <div v-for="conv in conversations" :key="conv.id" class="memory-item">
                                <div class="header">
                                    <span class="type" :style="{ background: conv.role === 'user' ? '#dbeafe' : '#fef3c7', color: conv.role === 'user' ? '#1e40af' : '#92400e' }">
                                        {{ conv.role === 'user' ? '👤 用户' : '🤖 助手' }}
                                    </span>
                                    <span style="color: #909399; font-size: 13px;">{{ formatDate(conv.timestamp) }}</span>
                                </div>
                                <div class="content" style="white-space: pre-wrap;">{{ conv.content }}</div>
                                <div class="meta">
                                    <span>会话：{{ conv.session_id }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 设置页面 -->
                <div v-if="currentPage === 'settings'">
                    <div class="card">
                        <h2>⚙️ LLM 配置</h2>
                        <p style="color: #64748b; margin-bottom: 20px;">配置大模型 API 以启用智能记忆摘要功能</p>

                        <div style="max-width: 600px;">
                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 8px; color: #606266; font-weight: 500;">服务商</label>
                                <select v-model="llmForm.provider" style="width: 100%; padding: 12px; border: 1px solid #dcdfe6; border-radius: 8px; font-size: 14px;">
                                    <option value="anthropic">Anthropic (Claude)</option>
                                    <option value="openai">OpenAI (GPT)</option>
                                    <option value="deepseek">DeepSeek</option>
                                    <option value="custom">自定义 API</option>
                                </select>
                            </div>

                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 8px; color: #606266; font-weight: 500;">API Key</label>
                                <input v-model="llmForm.api_key" type="password" placeholder="输入你的 API Key"
                                       style="width: 100%; padding: 12px; border: 1px solid #dcdfe6; border-radius: 8px; font-size: 14px;">
                            </div>

                            <div style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 8px; color: #606266; font-weight: 500;">模型名称</label>
                                <input v-model="llmForm.model" placeholder="例如：claude-sonnet-4-20250514, gpt-4o, deepseek-chat"
                                       style="width: 100%; padding: 12px; border: 1px solid #dcdfe6; border-radius: 8px; font-size: 14px;">
                                <div style="font-size: 12px; color: #94a3b8; margin-top: 4px;">
                                    <span v-if="llmForm.provider === 'anthropic'">推荐：claude-sonnet-4-20250514</span>
                                    <span v-else-if="llmForm.provider === 'openai'">推荐：gpt-4o 或 gpt-3.5-turbo</span>
                                    <span v-else-if="llmForm.provider === 'deepseek'">推荐：deepseek-chat</span>
                                </div>
                            </div>

                            <div v-if="llmForm.provider === 'custom'" style="margin-bottom: 16px;">
                                <label style="display: block; margin-bottom: 8px; color: #606266; font-weight: 500;">自定义 API 地址</label>
                                <input v-model="llmForm.api_url" placeholder="https://your-api.com/v1/chat/completions"
                                       style="width: 100%; padding: 12px; border: 1px solid #dcdfe6; border-radius: 8px; font-size: 14px;">
                            </div>

                            <div style="margin-bottom: 16px;">
                                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                    <input type="checkbox" v-model="llmForm.enabled" style="width: 18px; height: 18px;">
                                    <span style="color: #606266; font-size: 14px;">启用 LLM 摘要（未启用时使用规则引擎）</span>
                                </label>
                            </div>

                            <div style="display: flex; gap: 10px; margin-top: 24px;">
                                <button @click="saveLLMConfig"
                                        style="padding: 12px 24px; background: #667eea; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 500;">
                                    💾 保存配置
                                </button>
                                <button @click="testLLMConnection" :disabled="testingConnection"
                                        style="padding: 12px 24px; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 500;">
                                    {{ testingConnection ? '测试中...' : '🧪 测试连接' }}
                                </button>
                            </div>

                            <div v-if="llmMessage" style="margin-top: 16px; padding: 12px; border-radius: 8px; font-size: 14px;"
                                 :style="llmMessageType === 'success' ? { background: '#d1fae5', color: '#065f46' } : { background: '#fee2e2', color: '#991b1b' }">
                                {{ llmMessage }}
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <h2>📖 配置说明</h2>
                        <div style="color: #64748b; line-height: 1.8;">
                            <p><strong>1. Anthropic (Claude)</strong> - 适合复杂的语义理解和摘要</p>
                            <p style="margin-left: 20px;">模型推荐：claude-sonnet-4-20250514</p>
                            <p><strong>2. OpenAI (GPT)</strong> - 平衡性能和成本</p>
                            <p style="margin-left: 20px;">模型推荐：gpt-4o 或 gpt-3.5-turbo</p>
                            <p><strong>3. DeepSeek</strong> - 性价比高</p>
                            <p style="margin-left: 20px;">模型推荐：deepseek-chat</p>
                            <p><strong>4. 自定义 API</strong> - 兼容 OpenAI 格式的其他服务（如 Ollama 本地部署）</p>
                        </div>
                    </div>
                </div>
            </main>

            <!-- 添加/编辑记忆对话框 -->
            <div v-if="showAddMemory || editingMemory" class="dialog-overlay" @click.self="closeDialog">
                <div class="dialog" style="background: white; border-radius: 12px; padding: 24px; max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto;">
                    <h2 style="margin-bottom: 20px;">{{ editingMemory ? '✏️ 编辑记忆' : '➕ 添加记忆' }}</h2>
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 8px; color: #606266;">记忆类型</label>
                        <div class="type-select">
                            <button :class="{ active: newMemoryType === 'fact' }" @click="newMemoryType = 'fact'">事实</button>
                            <button :class="{ active: newMemoryType === 'preference' }" @click="newMemoryType = 'preference'">偏好</button>
                            <button :class="{ active: newMemoryType === 'skill' }" @click="newMemoryType = 'skill'">技能</button>
                            <button :class="{ active: newMemoryType === 'experience' }" @click="newMemoryType = 'experience'">经验</button>
                        </div>
                    </div>
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; margin-bottom: 8px; color: #606266;">记忆内容</label>
                        <textarea v-model="newMemoryContent" rows="5" style="width: 100%; padding: 12px; border: 1px solid #dcdfe6; border-radius: 8px; font-size: 14px; resize: vertical;" placeholder="输入记忆内容..."></textarea>
                    </div>
                    <div style="margin-bottom: 20px;">
                        <label style="display: block; margin-bottom: 8px; color: #606266;">标签（用空格分隔）</label>
                        <input v-model="newMemoryTags" style="width: 100%; padding: 12px; border: 1px solid #dcdfe6; border-radius: 8px; font-size: 14px;" placeholder="例如：python 编程 开发">
                    </div>
                    <div class="dialog-footer">
                        <button @click="closeDialog" style="padding: 10px 20px; background: #f3f4f6; color: #6b7280; border: none; border-radius: 8px; cursor: pointer;">取消</button>
                        <button @click="saveMemory" style="padding: 10px 20px; background: #667eea; color: white; border: none; border-radius: 8px; cursor: pointer;">保存</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const { createApp, ref, reactive, onMounted, computed, onUnmounted } = Vue;

        createApp({
            setup() {
                const API_BASE = 'http://localhost:15001';

                const currentPage = ref('dashboard');
                const stats = reactive({
                    total_conversations: 0,
                    total_memories: 0,
                    database_size_bytes: 0,
                    active_sessions: 0,
                    memories_by_type: {}
                });
                const apiStats = reactive({
                    total_calls: 0,
                    avg_response_time_ms: 0,
                    error_count: 0,
                    calls_by_endpoint: {},
                    calls_by_source: {}
                });
                const apiConnected = ref(true);
                const lastCheckTime = ref('-');
                const responseTime = ref(0);
                const timeRange = ref('24 小时');

                const memories = ref([]);
                const conversations = ref([]);
                const loading = ref(false);
                const conversationsLoading = ref(false);
                const searchQuery = ref('');
                const filterType = ref('');
                const page = ref(1);
                const showAddMemory = ref(false);
                const editingMemory = ref(null);
                const newMemoryContent = ref('');
                const newMemoryType = ref('fact');
                const newMemoryTags = ref('');

                // 全局搜索
                const globalSearchQuery = ref('');
                const searchLoading = ref(false);
                const searchFocused = ref(false);
                const searchHistory = ref([]);
                const searchMemoriesOnly = ref(false);
                const searchConversationsOnly = ref(false);
                const searchExactMatch = ref(false);
                const searchResults = reactive({
                    show: false,
                    query: '',
                    memories: [],
                    conversations: []
                });

                // LLM 配置
                const llmConfig = reactive({
                    configured: false,
                    enabled: false,
                    provider: 'anthropic',
                    api_key: '',
                    model: '',
                    api_url: ''
                });
                const llmForm = reactive({
                    enabled: false,
                    provider: 'anthropic',
                    api_key: '',
                    model: '',
                    api_url: ''
                });
                const testingConnection = ref(false);
                const llmMessage = ref('');
                const llmMessageType = ref('success');

                // 检查 API 连接状态
                const checkApiHealth = async () => {
                    const startTime = Date.now();
                    try {
                        const res = await fetch(`${API_BASE}/health`);
                        const data = await res.json();
                        apiConnected.value = true;
                        responseTime.value = Date.now() - startTime;
                        lastCheckTime.value = new Date().toLocaleTimeString('zh-CN', { hour12: false });
                    } catch (e) {
                        apiConnected.value = false;
                        responseTime.value = 0;
                        lastCheckTime.value = '失败';
                    }
                };

                const getTypeLabel = (type) => {
                    const labels = {
                        'preference': '偏好',
                        'skill': '技能',
                        'experience': '经验',
                        'fact': '事实'
                    };
                    return labels[type] || type;
                };

                const formatDate = (dateStr) => {
                    if (!dateStr) return '-';
                    const date = new Date(dateStr);
                    return date.toLocaleString('zh-CN', { hour12: false });
                };

                const formatSize = (bytes) => {
                    if (bytes < 1024) return bytes + ' B';
                    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
                    return (bytes / 1024 / 1024).toFixed(2) + ' MB';
                };

                const loadStats = async () => {
                    try {
                        const res = await fetch(`${API_BASE}/api/stats`);
                        const data = await res.json();
                        stats.total_conversations = data.total_conversations;
                        stats.total_memories = data.total_memories;
                        stats.database_size_bytes = data.database_size_bytes;
                        stats.active_sessions = data.active_sessions;
                        stats.memories_by_type = data.memories_by_type || {};

                        // 加载 API 统计
                        if (data.api_stats) {
                            apiStats.total_calls = data.api_stats.total_calls || 0;
                            apiStats.avg_response_time_ms = data.api_stats.avg_response_time_ms || 0;
                            apiStats.error_count = data.api_stats.error_count || 0;
                            apiStats.calls_by_endpoint = data.api_stats.calls_by_endpoint || {};
                            apiStats.calls_by_source = data.api_stats.calls_by_source || {};
                        }
                    } catch (e) {
                        console.error('加载统计失败:', e);
                    }
                };

                const loadApiStats = async () => {
                    try {
                        const res = await fetch(`${API_BASE}/api/api-stats?hours=24`);
                        const data = await res.json();
                        apiStats.total_calls = data.total_calls || 0;
                        apiStats.avg_response_time_ms = data.avg_response_time_ms || 0;
                        apiStats.error_count = data.error_count || 0;
                        apiStats.calls_by_endpoint = data.calls_by_endpoint || {};
                        apiStats.calls_by_source = data.calls_by_source || {};
                    } catch (e) {
                        console.error('加载 API 统计失败:', e);
                    }
                };

                // 加载 LLM 配置
                const loadLLMConfig = async () => {
                    try {
                        const res = await fetch(`${API_BASE}/api/llm-config`);
                        const data = await res.json();
                        llmConfig.configured = data.configured || false;
                        llmConfig.enabled = data.enabled || false;
                        llmConfig.provider = data.provider || 'anthropic';
                        llmConfig.api_key = data.api_key || '';
                        llmConfig.model = data.model || '';
                        llmConfig.api_url = data.api_url || '';
                    } catch (e) {
                        console.error('加载 LLM 配置失败:', e);
                    }
                };

                // 保存 LLM 配置
                const saveLLMConfig = async () => {
                    llmMessage.value = '';
                    try {
                        const res = await fetch(`${API_BASE}/api/llm-config`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                enabled: llmForm.enabled,
                                provider: llmForm.provider,
                                api_key: llmForm.api_key,
                                model: llmForm.model,
                                api_url: llmForm.api_url
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            llmMessage.value = '配置已保存！';
                            llmMessageType.value = 'success';
                            loadLLMConfig();
                            // 同步表单到显示
                            llmForm.provider = llmConfig.provider;
                            llmForm.model = llmConfig.model;
                            llmForm.enabled = llmConfig.enabled;
                        } else {
                            llmMessage.value = '保存失败：' + (data.error || '未知错误');
                            llmMessageType.value = 'error';
                        }
                    } catch (e) {
                        llmMessage.value = '保存失败：' + e.message;
                        llmMessageType.value = 'error';
                    }
                };

                // 测试 LLM 连接
                const testLLMConnection = async () => {
                    testingConnection.value = true;
                    llmMessage.value = '';
                    try {
                        const res = await fetch(`${API_BASE}/api/llm-config/test`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                provider: llmForm.provider,
                                api_key: llmForm.api_key,
                                model: llmForm.model,
                                api_url: llmForm.api_url
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            llmMessage.value = '连接成功！响应：' + (data.response || 'OK');
                            llmMessageType.value = 'success';
                        } else {
                            llmMessage.value = '测试失败：' + (data.message || '未知错误');
                            llmMessageType.value = 'error';
                        }
                    } catch (e) {
                        llmMessage.value = '测试失败：' + e.message;
                        llmMessageType.value = 'error';
                    } finally {
                        testingConnection.value = false;
                    }
                };

                const loadMemories = async () => {
                    loading.value = true;
                    try {
                        let url = `${API_BASE}/api/memories?limit=50&offset=${(page.value - 1) * 50}`;
                        if (filterType.value) {
                            url += `&type=${filterType.value}`;
                        }
                        const res = await fetch(url);
                        const data = await res.json();
                        memories.value = data.memories || [];
                    } catch (e) {
                        console.error('加载记忆失败:', e);
                    } finally {
                        loading.value = false;
                    }
                };

                const searchMemories = async () => {
                    if (!searchQuery.value) {
                        loadMemories();
                        return;
                    }
                    loading.value = true;
                    try {
                        let url = `${API_BASE}/api/memories/search?q=${encodeURIComponent(searchQuery.value)}&limit=50`;
                        if (filterType.value) {
                            url += `&type=${filterType.value}`;
                        }
                        const res = await fetch(url);
                        const data = await res.json();
                        memories.value = data.results || [];
                    } catch (e) {
                        console.error('搜索失败:', e);
                    } finally {
                        loading.value = false;
                    }
                };

                const loadConversations = async () => {
                    conversationsLoading.value = true;
                    try {
                        const res = await fetch(`${API_BASE}/api/conversations?limit=50`);
                        const data = await res.json();
                        conversations.value = data.conversations || [];
                    } catch (e) {
                        console.error('加载对话失败:', e);
                    } finally {
                        conversationsLoading.value = false;
                    }
                };

                // 全局搜索函数
                const globalSearch = async () => {
                    const query = globalSearchQuery.value.trim();
                    if (!query) return;

                    searchLoading.value = true;
                    searchResults.show = true;
                    searchResults.query = query;
                    searchResults.memories = [];
                    searchResults.conversations = [];

                    // 保存到搜索历史
                    if (!searchHistory.value.includes(query)) {
                        searchHistory.value.unshift(query);
                        if (searchHistory.value.length > 10) {
                            searchHistory.value = searchHistory.value.slice(0, 10);
                        }
                    }

                    try {
                        // 搜索记忆
                        if (!searchConversationsOnly.value) {
                            let memUrl = `${API_BASE}/api/memories/search?q=${encodeURIComponent(query)}&limit=20`;
                            if (searchExactMatch.value) {
                                memUrl += `&min_score=0.8`;
                            }
                            const memRes = await fetch(memUrl);
                            const memData = await memRes.json();
                            searchResults.memories = memData.results || [];
                        }

                        // 搜索对话
                        if (!searchMemoriesOnly.value) {
                            const convRes = await fetch(`${API_BASE}/api/conversations?limit=200`);
                            const convData = await convRes.json();
                            const allConversations = convData.conversations || [];

                            // 前端过滤对话
                            const queryLower = query.toLowerCase();
                            searchResults.conversations = allConversations.filter(conv => {
                                const content = conv.content || '';
                                if (searchExactMatch.value) {
                                    return content.includes(query);
                                }
                                return content.toLowerCase().includes(queryLower);
                            }).slice(0, 20);
                        }
                    } catch (e) {
                        console.error('全局搜索失败:', e);
                    } finally {
                        searchLoading.value = false;
                    }
                };

                const clearSearchResults = () => {
                    searchResults.show = false;
                    searchResults.memories = [];
                    searchResults.conversations = [];
                };

                const highlightText = (text, query) => {
                    if (!query || !text) return text;
                    try {
                        const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
                        return text.replace(regex, '<span class="highlight">$1</span>');
                    } catch (e) {
                        return text;
                    }
                };

                const deleteMemory = async (id) => {
                    if (!confirm('确定要删除这条记忆吗？')) return;
                    try {
                        await fetch(`${API_BASE}/api/memories/${id}`, { method: 'DELETE' });
                        loadMemories();
                        loadStats();
                    } catch (e) {
                        alert('删除失败：' + e.message);
                    }
                };

                const editMemory = (mem) => {
                    editingMemory.value = mem;
                    newMemoryContent.value = mem.content;
                    newMemoryType.value = mem.memory_type;
                    newMemoryTags.value = Array.isArray(mem.tags) ? mem.tags.join(' ') : '';
                };

                const saveMemory = async () => {
                    try {
                        const tags = newMemoryTags.value.split(/\s+/).filter(t => t);
                        const url = editingMemory.value
                            ? `${API_BASE}/api/memories/${editingMemory.value.id}`
                            : `${API_BASE}/api/memories`;
                        const method = editingMemory.value ? 'PUT' : 'POST';

                        await fetch(url, {
                            method,
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                content: newMemoryContent.value,
                                memory_type: newMemoryType.value,
                                tags
                            })
                        });

                        closeDialog();
                        loadMemories();
                        loadStats();
                    } catch (e) {
                        alert('保存失败：' + e.message);
                    }
                };

                const closeDialog = () => {
                    showAddMemory.value = false;
                    editingMemory.value = null;
                    newMemoryContent.value = '';
                    newMemoryType.value = 'fact';
                    newMemoryTags.value = '';
                };

                const prevPage = () => { if (page.value > 1) { page.value--; loadMemories(); } };
                const nextPage = () => { page.value++; loadMemories(); };

                let healthCheckInterval = null;

                onMounted(() => {
                    loadStats();
                    loadApiStats();
                    loadMemories();
                    loadConversations();
                    checkApiHealth();
                    loadLLMConfig();

                    // 每 30 秒检查一次 API 健康
                    healthCheckInterval = setInterval(checkApiHealth, 30000);

                    // 每 60 秒刷新一次统计
                    const statsInterval = setInterval(() => {
                        loadStats();
                        loadApiStats();
                    }, 60000);

                    // 清理定时器
                    onUnmounted(() => {
                        if (healthCheckInterval) clearInterval(healthCheckInterval);
                        if (statsInterval) clearInterval(statsInterval);
                    });
                });

                return {
                    currentPage, stats, apiStats, memories, conversations, loading, conversationsLoading,
                    searchQuery, filterType, page, showAddMemory, editingMemory,
                    newMemoryContent, newMemoryType, newMemoryTags,
                    apiConnected, lastCheckTime, responseTime, timeRange,
                    // 全局搜索
                    globalSearchQuery, searchLoading, searchFocused, searchHistory,
                    searchMemoriesOnly, searchConversationsOnly, searchExactMatch,
                    searchResults,
                    // LLM 配置
                    llmConfig, llmForm, testingConnection, llmMessage, llmMessageType,
                    getTypeLabel, formatDate, formatSize,
                    loadStats, loadApiStats, loadMemories, searchMemories, loadConversations, checkApiHealth,
                    loadLLMConfig, saveLLMConfig, testLLMConnection,
                    deleteMemory, editMemory, saveMemory, closeDialog, prevPage, nextPage,
                    globalSearch, clearSearchResults, highlightText, Math
                };
            }
        }).use(ElementPlus).mount('#app');
    </script>
</body>
</html>
